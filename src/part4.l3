(define last-item
  (λ (lst)
    (if (empty? (cdr lst)
      (car lst)
      (last-item (cdr lst))
    )))

(define remove-last-item
  (λ (lst)
    (if (empty? (cdr lst))
    '()
    (cons (car lst) (remove-last-item (cdr lst))))
  ))

(define rotate-nth
  (λ (lst n)
   (if (= n 0)
      lst
      (rotate-nth (cons (last-item lst)
      (remove-last-item lst)) (- n 1))
   ))

   
